<!--
  An aperture with a break in it: a shutter, and a link. Two shapes only, so it
  still reads at 24px in a notification. The content sits inside a 58dp circle,
  well within the 66dp adaptive-icon safe zone, so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ring. trimPath leaves the gap; a stroked arc keeps it one path. -->
    <path
        android:pathData="M54,28 A26,26 0 1 1 53.99,28"
        android:strokeColor="#F2F5F7"
        android:strokeWidth="5.2"
        android:strokeLineCap="round"
        android:trimPathStart="0.035"
        android:trimPathEnd="0.855" />

    <!-- The lens. -->
    <path
        android:pathData="M54,54 m-10.2,0 a10.2,10.2 0 1,0 20.4,0 a10.2,10.2 0 1,0 -20.4,0"
        android:fillColor="#5AC8E8" />
</vector>
