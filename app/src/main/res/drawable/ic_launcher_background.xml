<!--
  The adaptive icon's background layer. A vector rather than a PNG, so the
  repository carries no binary image and the icon stays crisp at every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="18" android:startY="12"
                android:endX="90" android:endY="98"
                android:type="linear">
                <item android:offset="0" android:color="#FF16222B" />
                <item android:offset="1" android:color="#FF0A0F14" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
